<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>
    <category label="30200">
        <setting id="account_logged_in" type="bool" default="false" visible="false"/>
        <setting id="account_status" type="text" label="30202" default="" enable="false" visible="String.IsEqual(Setting(account_logged_in),true)"/>
        <setting id="account_login" type="action" label="30203" action="RunPlugin(plugin://$ID/?action=account_login)" option="close" visible="String.IsEqual(Setting(account_logged_in),false)"/>
        <setting id="account_logout" type="action" label="30205" action="RunPlugin(plugin://$ID/?action=account_logout)" option="close" visible="String.IsEqual(Setting(account_logged_in),true)"/>
    </category>
    <category label="30206">
        <setting id="use_account_playlists" type="bool" label="30207" default="true"/>
        <setting id="twitch_settings" type="action" label="30208" action="RunPlugin(plugin://$ID/?action=open_twitch_settings)" option="close"/>
    </category>
</settings>
