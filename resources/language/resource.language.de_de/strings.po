# Menu
msgctxt "#30001"
msgid "Latest uploads"
msgstr "Kürzlich hochgeladen"

msgctxt "#30002"
msgid "Most viewed"
msgstr "Meist gesehen"

msgctxt "#30003"
msgid "Browse"
msgstr "Durchsuchen"

msgctxt "#30004"
msgid "Search"
msgstr "Suche"

# Errors
msgctxt "#30101"
msgid "The search term must be at least 3 characters long."
msgstr "Der Suchbegriff muss mindestens 3 Zeichen lang sein."

# Account and playback
msgctxt "#30200"
msgid "Account"
msgstr "Konto"

msgctxt "#30201"
msgid "Email or login"
msgstr "E-Mail oder Login"

msgctxt "#30202"
msgid "Account status"
msgstr "Kontostatus"

msgctxt "#30203"
msgid "Sign in"
msgstr "Anmelden"

msgctxt "#30205"
msgid "Sign out"
msgstr "Abmelden / Sitzung zurücksetzen"

msgctxt "#30206"
msgid "Playback"
msgstr "Wiedergabe"

msgctxt "#30207"
msgid "Use account session for archive playback"
msgstr "Kontositzung für Archiv-Wiedergabe verwenden"

msgctxt "#30208"
msgid "Open Twitch add-on settings"
msgstr "Einstellungen des Twitch-Addons öffnen"

msgctxt "#30209"
msgid "Not signed in"
msgstr "Nicht angemeldet"

msgctxt "#30210"
msgid "Session expired"
msgstr "Sitzung abgelaufen"

msgctxt "#30211"
msgid "Signed in"
msgstr "Angemeldet"

msgctxt "#30212"
msgid "Open add-on settings"
msgstr "Addon-Einstellungen öffnen"

msgctxt "#30213"
msgid "Password"
msgstr "Passwort"

msgctxt "#30214"
msgid "Two-factor authentication code"
msgstr "Code der Zwei-Faktor-Authentifizierung"

msgctxt "#30215"
msgid "Sign-in cancelled because no code was entered"
msgstr "Anmeldung abgebrochen, weil kein Code eingegeben wurde"

msgctxt "#30216"
msgid "Sign-in failed"
msgstr "Anmeldung fehlgeschlagen"

msgctxt "#30217"
msgid "Do you want to sign out?"
msgstr "Möchtest du dich abmelden?"

msgctxt "#30218"
msgid "Signed out"
msgstr "Abgemeldet"

msgctxt "#30219"
msgid "Synchronize watch progress"
msgstr "Wiedergabefortschritt synchronisieren"

msgctxt "#30220"
msgid "Progress sync disabled"
msgstr "Fortschrittssynchronisierung deaktiviert"

msgctxt "#30221"
msgid "Progress synchronized"
msgstr "Fortschritt synchronisiert"

msgctxt "#30222"
msgid "Progress pending locally"
msgstr "Fortschritt lokal ausstehend"

msgctxt "#30223"
msgid "Sign in required for progress sync"
msgstr "Anmeldung für Fortschrittssynchronisierung erforderlich"

msgctxt "#30224"
msgid "Progress conflict needs a choice"
msgstr "Fortschrittskonflikt benötigt eine Auswahl"

msgctxt "#30225"
msgid "Keep Kodi progress"
msgstr "Kodi-Fortschritt behalten"

msgctxt "#30226"
msgid "Use account progress"
msgstr "Konto-Fortschritt verwenden"

msgctxt "#30227"
msgid "Mark as watched in account"
msgstr "Im Konto als gesehen markieren"

msgctxt "#30228"
msgid "Saved session, sign-in not verified"
msgstr "Gespeicherte Sitzung, Anmeldung nicht bestätigt"

msgctxt "#30229"
msgid "Could not mark stream as watched"
msgstr "Stream konnte nicht als gesehen markiert werden"

msgctxt "#30230"
msgid "Watched update sent but not yet confirmed by account"
msgstr "Gesehen-Markierung gesendet, aber noch nicht vom Konto bestätigt"

msgctxt "#30231"
msgid "Account watch status currently unavailable"
msgstr "Gesehen-Status des Kontos derzeit nicht verfügbar"

msgctxt "#30232"
msgid "Reset progress in account and Kodi"
msgstr "Fortschritt im Konto und in Kodi zurücksetzen"

msgctxt "#30233"
msgid "Reset this stream to zero in the account and Kodi? Playback will not start."
msgstr "Diesen Stream im Konto und in Kodi auf null zurücksetzen? Die Wiedergabe wird nicht gestartet."

msgctxt "#30234"
msgid "Stop playback and wait for active progress uploads before resetting"
msgstr "Vor dem Zurücksetzen die Wiedergabe beenden und laufende Fortschritts-Uploads abwarten"

msgctxt "#30235"
msgid "Progress reset could not be completed or confirmed"
msgstr "Fortschritt konnte nicht vollständig zurückgesetzt oder bestätigt werden"
